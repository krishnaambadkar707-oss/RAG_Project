# Server Configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# Database Configuration
DATABASE_URL=sqlite:///./rag_assistant.db

# Authentication
JWT_SECRET=supersecret_jwt_key_change_me_in_production_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM & Vector Store Settings
# Providers supported: sentence-transformers (default local embedding), openai, gemini
EMBEDDING_PROVIDER=sentence-transformers
LLM_PROVIDER=mock

# API Keys (Provide key if using OpenAI or Gemini)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Chroma Vector Database Directory
CHROMA_DB_DIR=./chroma_data
UPLOAD_DIR=./uploads
