# Server Configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# Database Configuration
DATABASE_URL=sqlite:///./rag_assistant.db

# Authentication
# IMPORTANT: Generate a secure random secret for production!
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration - Restrict to your frontend URL in production
# For development: localhost:3000 (frontend) and localhost:5173 (Vite)
# For production: set to your actual domain(s)
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# LLM & Vector Store Settings
# Providers supported: sentence-transformers (default local embedding), openai, gemini
EMBEDDING_PROVIDER=sentence-transformers
LLM_PROVIDER=mock

# API Keys (Provide key if using OpenAI or Gemini)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Chroma Vector Database Directory
CHROMA_DB_DIR=./chroma_data
UPLOAD_DIR=./uploads
