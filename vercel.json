{
  "functions": {
    "api/index.py": {
      "runtime": "python3.11",
      "includeFiles": "rag_assistant.db,backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}